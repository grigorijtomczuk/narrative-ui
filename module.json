{
	"id": "narrative-ui",
	"title": "Narrative UI",
	"description": "A neat UI theme for your favorite virtual tabletop.",
	"version": "1.1.0",
	"compatibility": {
		"minimum": "14",
		"verified": "14.367"
	},
	"relationships": {
		"requires": [
			{
				"id": "lib-wrapper",
				"type": "module"
			}
		],
		"systems": [
			{
				"id": "dnd5e",
				"type": "system"
			}
		]
	},
	"authors": [
		{
			"name": "grigorijtomczuk",
			"email": "grigorijtomczuk@gmail.com",
			"url": "https://grigorijtomczuk.ru",
			"discord": "grigorijtomczuk"
		}
	],
	"languages": [
		{
			"lang": "en",
			"name": "English",
			"path": "lang/en.json"
		},
		{
			"lang": "ru",
			"name": "Russian",
			"path": "lang/ru.json"
		}
	],
	"esmodules": ["scripts/hooks.js"],
	"styles": [
		"styles/chat.css",
		"styles/sidebar.css",
		"styles/context-menu.css"
	],
	"flags": {
		"hotReload": {
			"extensions": ["js", "css"],
			"paths": ["scripts", "styles"]
		}
	},
